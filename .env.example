# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
# LiteLLM uses this to route calls to Gemini models.
# In your prompt/model field, use prefix: "gemini/gemini-1.5-flash"
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Database (SQLAlchemy — optional, not active yet) ──────────────────────────
# Only needed if you enable the DB session / models layer.
DATABASE_URL=postgresql://user:password@localhost:5432/agentdb

# ─── Agent Execution ───────────────────────────────────────────────────────────
# Max seconds the subprocess agent is allowed to run before timeout
AGENT_TIMEOUT=30

# ─── MCP Server URLs ───────────────────────────────────────────────────────────
# These are only needed if you use MCP-strategy agents (Strategy B).
# Start the corresponding MCP server BEFORE running those agents.
#
# Mermaid MCP   → npx @mermaid-js/mermaid-mcp@latest --port 3001
MCP_MERMAID_URL=http://localhost:3001
#
# Filesystem MCP → npx @modelcontextprotocol/server-filesystem ./sandbox --port 3002
MCP_FILESYSTEM_URL=http://localhost:3002
#
# Fetch MCP      → uvx mcp-server-fetch --port 3003
MCP_FETCH_URL=http://localhost:3003
#
# SQLite MCP     → uvx mcp-server-sqlite --db-path ./data/sample.db --port 3004
MCP_SQLITE_URL=http://localhost:3004
#
# Sequential Thinking MCP → npx @modelcontextprotocol/server-sequential-thinking --port 3005
MCP_SEQUENTIAL_THINKING_URL=http://localhost:3005

# ─── Tool-Specific Paths ───────────────────────────────────────────────────────
# Path to the SQLite database used by the sqlite-analyst agent
SQLITE_DB_PATH=./data/sample.db

# Sandboxed directory the code-reader agent is allowed to read from
FILESYSTEM_SANDBOX_PATH=./sandbox
