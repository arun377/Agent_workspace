import asyncio
import sys
import json
from pathlib import Path

from langchain_litellm import ChatLiteLLM
from langgraph.prebuilt import create_react_agent
from langchain_mcp_adapters.client import MultiServerMCPClient
from app.tools.builtin.builtin import BUILTIN_TOOLS
from app.tools.mcp_servers import MCP_SERVERS

AGENT_NAME = "{{ agent_name }}"
PROMPT = """{{ prompt }}"""
MODEL_STRING = "{{ model }}"
SELECTED_TOOL_IDS = {{ tools }}

model = ChatLiteLLM(model=MODEL_STRING)

async def build_tools():
    tools = []
    mcp_ids_by_server = {}

    for tool_id in SELECTED_TOOL_IDS:
        if tool_id in BUILTIN_TOOLS:
            tools.append(BUILTIN_TOOLS[tool_id])
        elif ":" in tool_id:
            server_id, tool_name = tool_id.split(":", 1)
            mcp_ids_by_server.setdefault(server_id, []).append(tool_name)

    for server_id, tool_names in mcp_ids_by_server.items():
        client = MultiServerMCPClient({server_id: MCP_SERVERS[server_id]})
        server_tools = await client.get_tools()
        for t in server_tools:
            if t.name in tool_names:
                tools.append(t)
    return tools

def emit_event(event_type: str, summary: str, data: dict = None):
    payload = {
        "type": event_type,
        "summary": summary,
        "data": data or {}
    }
    print(json.dumps(payload), flush=True)

async def run(payload: dict):
    input_text = payload.get("input_text", "")
    session_id = payload.get("session_id", "default_session")

    emit_event("status", f"Starting run for session {session_id}...")
    try:
        tools = await build_tools()
        agent = create_react_agent(model=model, tools=tools, prompt=PROMPT)

        full_answer_chunks = []
        final_fallback_answer = ""
        input_payload = {"messages": [{"role": "user", "content": input_text}]}
        active_steps = {}

        async for event in agent.astream_events(input_payload, version="v2"):
            kind = event["event"]
            run_id = event.get("run_id")
            name = event.get("name")

            # 1. LLM Start
            if kind == "on_chat_model_start":
                input_data = event.get("data", {}).get("input")
                active_steps[run_id] = {
                    "step_type": "llm",
                    "name": name,
                    "input": str(input_data) if input_data else None,
                    "content": [],
                    "tool_calls": [],
                    "output": None,
                    "error": None,
                    "token_usage": None
                }
                emit_event("step", f"Starting LLM {name}", active_steps[run_id])

            # 2. Token Streaming (Defensive text extraction)
            elif kind == "on_chat_model_stream":
                chunk = event["data"].get("chunk")
                content = getattr(chunk, "content", "")
                
                text_piece = ""
                if isinstance(content, str):
                    text_piece = content
                elif isinstance(content, list):
                    text_piece = "".join([
                        c.get("text", "") if isinstance(c, dict) else str(c) 
                        for c in content 
                        if not (isinstance(c, dict) and c.get("type") == "thinking")
                    ])

                if text_piece:
                    full_answer_chunks.append(text_piece)
                    emit_event("token", "Generating response...", {"token": text_piece})

            # 3. LLM End
            elif kind == "on_chat_model_end":
                step = active_steps.get(run_id)
                if step:
                    output = event["data"].get("output")
                    if output:
                        msg_content = getattr(output, "content", "")
                        formatted_content = []
                        if isinstance(msg_content, str) and msg_content:
                            formatted_content.append({"type": "text", "text": msg_content})
                        elif isinstance(msg_content, list):
                            for block in msg_content:
                                if isinstance(block, dict):
                                    if block.get("type") == "thinking":
                                        formatted_content.append({"type": "thinking", "thinking": block.get("thinking", "")})
                                    elif block.get("type") == "text":
                                        formatted_content.append({"type": "text", "text": block.get("text", "")})
                                    else:
                                        formatted_content.append(block)
                                else:
                                    formatted_content.append({"type": "text", "text": str(block)})

                        step["content"] = formatted_content
                        step["tool_calls"] = getattr(output, "tool_calls", [])

                        metadata = getattr(output, "response_metadata", {})
                        usage = getattr(output, "usage_metadata", {})
                        token_usage = usage or metadata.get("token_usage", {})
                        
                        if token_usage:
                             step["token_usage"] = token_usage

                        reasoning_tokens = token_usage.get("output_token_details", {}).get("reasoning", 0) if isinstance(token_usage, dict) else 0
                        has_thinking = any(isinstance(b, dict) and b.get("type") == "thinking" for b in formatted_content)
                        if reasoning_tokens > 0 and not has_thinking:
                            formatted_content.append({"type": "thinking", "thinking": None})

                        step["output"] = str(msg_content)

                    emit_event("step", f"Finished LLM {name}", step)

            # 4. Tool Invocations
            elif kind == "on_tool_start":
                active_steps[run_id] = {
                    "step_type": "tool",
                    "name": name,
                    "input": event["data"].get("input"),
                    "content": [],
                    "tool_calls": [],
                    "output": None,
                    "error": None,
                    "token_usage": None
                }
                emit_event("step", f"Calling `{name}`", active_steps[run_id])
                
                # Backwards compatibility
                emit_event("tool_call", f"Calling `{name}`", {
                    "tool": name,
                    "input": event["data"].get("input")
                })

            # 5. Tool Results
            elif kind == "on_tool_end":
                step = active_steps.get(run_id)
                if step:
                    step["output"] = str(event["data"].get("output"))
                    emit_event("step", f"Finished `{name}`", step)
                
                emit_event("tool_result", f"Finished `{name}`", {
                    "tool": name,
                    "output": str(event["data"].get("output"))
                })
                
            # 6. Errors (Chain, tool, etc)
            elif kind in ["on_tool_error", "on_chain_error", "on_chat_model_error"]:
                step = active_steps.get(run_id)
                if step:
                    step["error"] = str(event["data"].get("error"))
                    emit_event("step", f"Error in `{name}`", step)

            # 7. Fallback: Capture final output from chain completion
            elif kind == "on_chain_end" and event.get("name") == "LangGraph":
                output = event["data"].get("output")
                if isinstance(output, dict) and "messages" in output:
                    last_msg = output["messages"][-1]
                    final_fallback_answer = getattr(last_msg, "content", "")

        # Consolidate answer
        assembled_answer = "".join(full_answer_chunks).strip()
        final_output = assembled_answer if assembled_answer else final_fallback_answer

        emit_event("completed", "Execution finished.", {
            "final_answer": final_output,
            "session_id": session_id
        })

    except Exception as e:
        emit_event("error", f"Subprocess encountered an exception: {str(e)}", {"stderr": str(e)})

if __name__ == "__main__":
    raw_input = sys.stdin.read()
    try:
        data = json.loads(raw_input) if raw_input.strip().startswith("{") else {"input_text": raw_input}
        asyncio.run(run(data))
    except Exception as e:
        emit_event("error", f"Subprocess encountered an exception: {str(e)}", {"stderr": str(e)})