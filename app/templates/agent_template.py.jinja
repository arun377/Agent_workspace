import asyncio
import sys
import json
from pathlib import Path
from langchain_litellm import ChatLiteLLM
from langgraph.prebuilt import create_react_agent
from langchain_mcp_adapters.client import MultiServerMCPClient
from app.tools.builtin.builtin import BUILTIN_TOOLS
from app.tools.mcp_servers import MCP_SERVERS

AGENT_NAME = "{{ agent_name }}"
PROMPT = """{{ prompt }}"""
MODEL_STRING = "{{ model }}"
SELECTED_TOOL_IDS = {{ tools }}

model = ChatLiteLLM(model=MODEL_STRING)

async def build_tools():
    tools = []
    mcp_ids_by_server = {}

    for tool_id in SELECTED_TOOL_IDS:
        if tool_id in BUILTIN_TOOLS:
            tools.append(BUILTIN_TOOLS[tool_id])
        elif ":" in tool_id:
            server_id, tool_name = tool_id.split(":", 1)
            mcp_ids_by_server.setdefault(server_id, []).append(tool_name)

    for server_id, tool_names in mcp_ids_by_server.items():
        client = MultiServerMCPClient({server_id: MCP_SERVERS[server_id]})
        server_tools = await client.get_tools()
        for t in server_tools:
            if t.name in tool_names:
                tools.append(t)
    return tools

def emit_event(event_type: str, summary: str, data: dict = None):
    payload = {
        "type": event_type,
        "summary": summary,
        "data": data or {}
    }
    # Output solely as line-delimited JSON to stdout
    print(json.dumps(payload), flush=True)

async def run(payload: dict):
    input_text = payload.get("input_text", "")
    session_id = payload.get("session_id", "default_session")

    emit_event("status", f"Starting run for session {session_id}...")
    tools = await build_tools()
    agent = create_react_agent(model=model, tools=tools, prompt=PROMPT)

    full_answer_chunks = []
    final_fallback_answer = ""

    input_payload = {"messages": [{"role": "user", "content": input_text}]}

    async for event in agent.astream_events(input_payload, version="v2"):
        kind = event["event"]

        # 1. Tool Invocations
        if kind == "on_tool_start":
            tool_input = event["data"].get("input", {})
            if isinstance(tool_input, dict) and "input" in tool_input:
                 tool_input = tool_input["input"]
            emit_event("tool_call", f"Calling `{event['name']}`", {
                "tool": event["name"],
                "input": tool_input
            })

        # 2. Tool Results
        elif kind == "on_tool_end":
            output_val = event["data"].get("output")
            if hasattr(output_val, "content"):
                output_val = output_val.content
            elif hasattr(output_val, "artifact"):
                output_val = output_val.artifact
            emit_event("tool_result", f"Finished `{event['name']}`", {
                "tool": event["name"],
                "output": output_val
            })
            
        # 3. Tool Errors
        elif kind == "on_tool_error":
            emit_event("tool_error", f"Error in `{event['name']}`", {
                "tool": event["name"],
                "error": str(event["data"].get("error"))
            })

        # 4. Token Streaming (Defensive text extraction)
        elif kind == "on_chat_model_stream":
            chunk = event["data"].get("chunk")
            content = getattr(chunk, "content", "")
            
            text_piece = ""
            if isinstance(content, str):
                text_piece = content
            elif isinstance(content, list):
                text_piece = "".join([c.get("text", "") if isinstance(c, dict) else str(c) for c in content])

            if text_piece:
                full_answer_chunks.append(text_piece)
                emit_event("token", "Generating response...", {"token": text_piece})

        # 5. LLM Call Tracing (Start & End)
        elif kind == "on_chat_model_start":
            emit_event("llm_call_start", f"Starting LLM call for `{event['name']}`", {
                "input": "User Input Received" # Simplified to avoid massive strings
            })
            
        elif kind == "on_chat_model_end":
            output_msg = event["data"].get("output")
            token_usage = {}
            content = ""
            tool_calls = []
            
            if hasattr(output_msg, "usage_metadata") and output_msg.usage_metadata:
                token_usage = output_msg.usage_metadata
            elif hasattr(output_msg, "response_metadata") and "token_usage" in output_msg.response_metadata:
                tu = output_msg.response_metadata["token_usage"]
                if hasattr(tu, "model_dump"):
                    token_usage = tu.model_dump()
                elif isinstance(tu, dict):
                    token_usage = tu
            
            if hasattr(output_msg, "content"):
                content = output_msg.content
            if hasattr(output_msg, "tool_calls"):
                tool_calls = output_msg.tool_calls
            
            emit_event("llm_call_end", f"Finished LLM call for `{event['name']}`", {
                "content": content,
                "tool_calls": tool_calls,
                "token_usage": token_usage
            })
            
        # 6. Chain / Plan Level Tracing
        elif kind == "on_chain_start":
            emit_event("chain_start", f"Starting chain `{event['name']}`", {
                "input": str(event["data"].get("input"))
            })

        # 7. Fallback & Chain End
        elif kind == "on_chain_end":
            emit_event("chain_end", f"Finished chain `{event['name']}`", {
                "output": str(event["data"].get("output"))
            })
            if event["name"] == "LangGraph":
                output = event["data"].get("output")
                if isinstance(output, dict) and "messages" in output:
                    last_msg = output["messages"][-1]
                    final_fallback_answer = getattr(last_msg, "content", "")
                    
        # 8. Chain Errors
        elif kind == "on_chain_error":
            emit_event("chain_error", f"Error in chain `{event['name']}`", {
                "error": str(event["data"].get("error"))
            })

    # Consolidate answer
    assembled_answer = "".join(full_answer_chunks).strip()
    final_output = assembled_answer if assembled_answer else final_fallback_answer

    emit_event("completed", "Execution finished.", {
        "final_answer": final_output,
        "session_id": session_id
    })

if __name__ == "__main__":
    raw_input = sys.stdin.read()
    try:
        data = json.loads(raw_input) if raw_input.strip().startswith("{") else {"input_text": raw_input}
        asyncio.run(run(data))
    except Exception as e:
        emit_event("error", f"Subprocess encountered an exception: {str(e)}")